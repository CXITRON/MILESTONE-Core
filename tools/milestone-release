#!/usr/bin/env bash
set -Eeuo pipefail

PROGRAM=${0##*/}
EXPECTED_REPO='CXITRON/MILESTONE-Core'
DEFAULT_PROJECT_DIR=${MILESTONE_PROJECT_DIR:-'/run/media/citron/T7/Documents/Dev/MILESTONE_Core'}
EXPECTED_AUTHOR_NAME='CXITRON'
EXPECTED_AUTHOR_EMAIL='cxitron@proton.me'
# Commit hygiene was explicitly adopted from this known-clean baseline onward.
COMMIT_POLICY_BASE='08e00769024dc153796f6df30b8908b34031a5c4'

MODE=''
VERSION=''
NOTES=''
ASSUME_YES=0
DRY_RUN=0
INPUT_ZIP=''
PROJECT_DIR=''
TAILDROP_ROOT=''
BACKUP_DIR=''
REMOTE_PUSHED=0
SWAPPED_PROJECT=0

usage() {
  cat <<'USAGE'
MILESTONE Core release automation

Usage:
  milestone-release [--yes] [--dry-run] local VERSION [NOTES]
  milestone-release [--yes] [--dry-run] taildrop VERSION [NOTES]
  milestone-release [--yes] [--dry-run] --zip FILE taildrop VERSION [NOTES]

Modes:
  local     Run from the MILESTONE_Core project root. Uses the current working tree.
  taildrop  Run outside the live project root. Receives MILESTONE_Core_VERSION.zip
            with Taildrop and safely replaces the live project directory.

Options:
  -y, --yes      Accept the final GitHub publish confirmation automatically.
  -n, --dry-run  Validate, test, and build only. Do not commit, replace the local
                 project, create/push a tag, push main, or create a GitHub Release.
  --zip FILE      Use an already received ZIP instead of calling Tailscale file get.
                  Valid only with taildrop mode; the source ZIP is not modified.
  -h, --help     Show this help.

Examples:
  cd /run/media/citron/T7/Documents/Dev/MILESTONE_Core
  milestone-release local 1.8.3 "Harden diagnostics persistence"

  cd /tmp && milestone-release taildrop 1.8.3 "Harden diagnostics persistence"
USAGE
}

log() {
  printf '\n\033[1;36m==> %s\033[0m\n' "$*"
}

warn() {
  printf '\033[1;33m경고: %s\033[0m\n' "$*" >&2
}

die() {
  printf '\033[1;31m오류: %s\033[0m\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "필수 명령을 찾지 못했습니다: $1"
}

cleanup() {
  local status=$?

  if (( status != 0 )) && (( SWAPPED_PROJECT == 1 )) && (( REMOTE_PUSHED == 0 )); then
    warn "게시 전 오류가 발생해 기존 프로젝트를 복구합니다."
    if [[ -n $PROJECT_DIR && -d $PROJECT_DIR ]]; then
      rm -rf -- "$PROJECT_DIR"
    fi
    if [[ -n $BACKUP_DIR && -d $BACKUP_DIR ]]; then
      mv -- "$BACKUP_DIR" "$PROJECT_DIR"
      warn "기존 프로젝트 복구 완료: $PROJECT_DIR"
    fi
  fi

  if [[ -n $TAILDROP_ROOT && -d $TAILDROP_ROOT ]]; then
    rm -rf -- "$TAILDROP_ROOT"
  fi

  if (( status != 0 )) && (( REMOTE_PUSHED == 1 )); then
    warn "Git 원격 push 이후 단계에서 실패했습니다. 프로젝트는 새 버전을 유지합니다."
    warn "같은 milestone-release 명령을 다시 실행하면 동일 태그를 확인한 뒤 Release 생성을 재시도할 수 있습니다."
    if [[ -n $BACKUP_DIR && -d $BACKUP_DIR ]]; then
      warn "이전 프로젝트 백업은 보존했습니다: $BACKUP_DIR"
    fi
  fi

  exit "$status"
}
trap cleanup EXIT

while (( $# > 0 )); do
  case "$1" in
    -y|--yes)
      ASSUME_YES=1
      shift
      ;;
    -n|--dry-run)
      DRY_RUN=1
      shift
      ;;
    --zip)
      shift
      (( $# > 0 )) || die "--zip 뒤에 ZIP 파일 경로가 필요합니다."
      INPUT_ZIP=$1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    local|taildrop)
      [[ -z $MODE ]] || die "모드는 하나만 지정할 수 있습니다."
      MODE=$1
      shift
      ;;
    *)
      if [[ -z $VERSION ]]; then
        VERSION=$1
      elif [[ -z $NOTES ]]; then
        NOTES=$1
      else
        die "인자가 너무 많습니다."
      fi
      shift
      ;;
  esac
done

[[ $MODE == local || $MODE == taildrop ]] || { usage >&2; exit 2; }
[[ $MODE == taildrop || -z $INPUT_ZIP ]] || die "--zip은 taildrop 모드에서만 사용할 수 있습니다."
[[ $VERSION =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "VERSION은 1.8.3과 같은 형식이어야 합니다."
NOTES=${NOTES:-"MILESTONE Core v${VERSION}"}
TAG="v${VERSION}"

require_command git
require_command gh
require_command g++
require_command unzip
require_command grep
require_command sed
require_command awk
require_command sha256sum
require_command stat
require_command strings
require_command realpath
require_command date
require_command mktemp
require_command install

validate_project_root() {
  local dir=$1
  [[ -d $dir ]] || die "프로젝트 디렉터리가 없습니다: $dir"
  [[ -d $dir/.git ]] || die "Git 저장소가 아닙니다: $dir"
  [[ -f $dir/MILESTONE_Core.ino ]] || die "MILESTONE_Core.ino가 없습니다: $dir"
  [[ -f $dir/tools/make-release.sh ]] || die "tools/make-release.sh가 없습니다."
  [[ -f $dir/tools/test-core.sh ]] || die "tools/test-core.sh가 없습니다."

  local top
  top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || die "Git 루트를 확인하지 못했습니다."
  [[ $(realpath "$top") == $(realpath "$dir") ]] || die "프로젝트 루트에서 실행해야 합니다: $top"
}

validate_source_version() {
  local dir=$1
  local source_version
  source_version=$(sed -n 's/.*FIRMWARE_VERSION\[\] = "\([0-9][0-9.]*\)".*/\1/p' "$dir/MILESTONE_Core.ino" | head -n1)
  [[ -n $source_version ]] || die "소스에서 FIRMWARE_VERSION을 읽지 못했습니다."
  [[ $source_version == "$VERSION" ]] || die "요청 버전($VERSION)과 소스 버전($source_version)이 다릅니다."
}

validate_git_identity() {
  local name email
  name=$(git -C "$PROJECT_DIR" config user.name || true)
  email=$(git -C "$PROJECT_DIR" config user.email || true)
  [[ $name == "$EXPECTED_AUTHOR_NAME" ]] || die "git user.name이 '$EXPECTED_AUTHOR_NAME'이 아닙니다: '$name'"
  [[ $email == "$EXPECTED_AUTHOR_EMAIL" ]] || die "git user.email이 '$EXPECTED_AUTHOR_EMAIL'이 아닙니다: '$email'"
}

validate_branch_and_remote() {
  local branch remote
  branch=$(git -C "$PROJECT_DIR" branch --show-current)
  [[ $branch == main ]] || die "main 브랜치에서만 릴리즈할 수 있습니다. 현재: ${branch:-DETACHED}"

  remote=$(git -C "$PROJECT_DIR" remote get-url origin 2>/dev/null) || die "origin remote가 없습니다."
  case "$remote" in
    git@github.com:CXITRON/MILESTONE-Core.git|\
    https://github.com/CXITRON/MILESTONE-Core.git|\
    ssh://git@github.com/CXITRON/MILESTONE-Core.git)
      ;;
    *)
      die "예상하지 않은 origin remote입니다: $remote"
      ;;
  esac
}

find_common_release_base() {
  local tag
  while IFS= read -r tag; do
    [[ -n $tag ]] || continue
    [[ $tag == "$TAG" ]] && continue
    if git -C "$PROJECT_DIR" merge-base --is-ancestor "$tag" HEAD &&
       git -C "$PROJECT_DIR" merge-base --is-ancestor "$tag" origin/main; then
      printf '%s\n' "$tag"
      return 0
    fi
  done < <(git -C "$PROJECT_DIR" tag --sort=-v:refname | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$')
  return 1
}

source_version_at_ref() {
  local ref=$1
  git -C "$PROJECT_DIR" show "${ref}:MILESTONE_Core.ino" 2>/dev/null \
    | sed -n 's/.*FIRMWARE_VERSION\[\] = "\([0-9][0-9.]*\)".*/\1/p' \
    | head -n1
}

find_taildrop_version_anchor() {
  local wanted_version=$1
  local lower_bound=$2
  local remote_ref=${3:-origin/main}
  local lower_bound_commit commit commit_version candidate_tree remote_tree fallback=''
  lower_bound_commit=$(git -C "$PROJECT_DIR" rev-list -n1 "$lower_bound") || return 1
  remote_tree=$(git -C "$PROJECT_DIR" rev-parse "${remote_ref}^{tree}" 2>/dev/null) || return 1

  while IFS= read -r commit; do
    [[ -n $commit ]] || continue
    commit_version=$(source_version_at_ref "$commit")
    if [[ $commit_version == "$wanted_version" ]]; then
      [[ -n $fallback ]] || fallback=$commit
      candidate_tree=$(git -C "$PROJECT_DIR" rev-parse "${commit}^{tree}" 2>/dev/null || true)
      if [[ -n $candidate_tree && $candidate_tree == "$remote_tree" ]]; then
        printf '%s\n' "$commit"
        return 0
      fi
    fi
    [[ $commit == "$lower_bound_commit" ]] && break
  done < <(git -C "$PROJECT_DIR" rev-list main)

  # Older release packages may not contain a byte-identical remote snapshot.
  # Preserve the previous behavior as a compatibility fallback, but prefer an
  # exact tree match whenever one exists so same-version documentation/tooling
  # commits that never reached origin/main are not mistaken for the release base.
  [[ -n $fallback ]] || return 1
  printf '%s\n' "$fallback"
}

reconcile_taildrop_with_remote() {
  [[ $MODE == taildrop ]] || return 1

  local base_tag
  base_tag=$(find_common_release_base) || \
    die "Taildrop 프로젝트와 origin/main의 공통 이전 릴리즈 태그를 찾지 못했습니다. 자동 병합하지 않습니다."

  local remote_version version_anchor short_anchor
  remote_version=$(source_version_at_ref origin/main)
  [[ $remote_version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || \
    die "origin/main에서 펌웨어 버전을 확인하지 못했습니다. 자동 병합하지 않습니다."
  version_anchor=$(find_taildrop_version_anchor "$remote_version" "$base_tag" origin/main) || \
    die "Taildrop 이력에서 origin/main 펌웨어 v${remote_version}에 대응하는 안전한 기준점을 찾지 못했습니다. 자동 병합하지 않습니다."
  [[ $version_anchor != $(git -C "$PROJECT_DIR" rev-parse HEAD) ]] || \
    die "Taildrop과 origin/main이 같은 펌웨어 버전이지만 이력이 다릅니다. 자동 병합하지 않습니다."
  short_anchor=$(git -C "$PROJECT_DIR" rev-parse --short "$version_anchor")

  log "원격 main 변경 감지: ${base_tag} 공통 태그, 원격 v${remote_version} 대응 기준 ${short_anchor} 이후 Taildrop 변경만 재적용"
  if ! git -C "$PROJECT_DIR" rebase --onto origin/main "$version_anchor" main; then
    git -C "$PROJECT_DIR" rebase --abort >/dev/null 2>&1 || true
    die "원격 변경과 Taildrop 변경이 충돌했습니다. 기존 프로젝트는 변경하지 않았습니다."
  fi

  git -C "$PROJECT_DIR" merge-base --is-ancestor origin/main HEAD || \
    die "원격 main 재적용 후 ancestry 검증에 실패했습니다."
}

refresh_installed_command() {
  local target_dir="$HOME/.local/bin"
  local target="$target_dir/milestone-release"
  mkdir -p -- "$target_dir"
  install -m 0755 -- "$PROJECT_DIR/tools/milestone-release" "$target"
  log "설치된 milestone-release 명령 갱신 완료"
}

refresh_remote() {
  log "GitHub 원격 상태 확인"
  gh auth status >/dev/null
  git -C "$PROJECT_DIR" fetch --quiet origin main --tags

  if ! git -C "$PROJECT_DIR" merge-base --is-ancestor origin/main HEAD; then
    if [[ $MODE == taildrop ]]; then
      reconcile_taildrop_with_remote
    else
      die "현재 HEAD가 origin/main을 포함하지 않습니다. 먼저 원격 변경을 정리하세요."
    fi
  fi
}

build_release() {
  log "호스트 테스트 + ESP32 릴리즈 빌드"
  (
    cd "$PROJECT_DIR"
    bash ./tools/make-release.sh "$VERSION" "$NOTES"
  )

  local manifest="$PROJECT_DIR/release/MILESTONE_Core.json"
  local bin="$PROJECT_DIR/release/MILESTONE_Core.bin"
  [[ -s $bin ]] || die "릴리즈 BIN이 생성되지 않았습니다."
  [[ -s $manifest ]] || die "릴리즈 manifest가 생성되지 않았습니다."

  local manifest_version manifest_size actual_size manifest_sha actual_sha
  manifest_version=$(sed -n 's/^[[:space:]]*"version":[[:space:]]*"\([^"]*\)".*/\1/p' "$manifest")
  manifest_size=$(sed -n 's/^[[:space:]]*"size":[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$manifest")
  manifest_sha=$(sed -n 's/^[[:space:]]*"sha256":[[:space:]]*"\([0-9a-fA-F]*\)".*/\1/p' "$manifest")
  actual_size=$(stat -c '%s' -- "$bin")
  actual_sha=$(sha256sum -- "$bin" | awk '{print $1}')

  [[ $manifest_version == "$VERSION" ]] || die "manifest 버전이 다릅니다: $manifest_version"
  [[ $manifest_size == "$actual_size" ]] || die "manifest size와 BIN 크기가 다릅니다."
  [[ ${manifest_sha,,} == "$actual_sha" ]] || die "manifest SHA-256과 BIN SHA-256이 다릅니다."

  printf 'BIN:      %s bytes\n' "$actual_size"
  printf 'SHA-256:  %s\n' "$actual_sha"
}

commit_local_changes_if_needed() {
  [[ $MODE == local ]] || return 0

  local status
  status=$(git -C "$PROJECT_DIR" status --porcelain)
  [[ -n $status ]] || return 0

  log "로컬 변경사항 확인"
  git -C "$PROJECT_DIR" status --short

  if (( DRY_RUN == 1 )); then
    warn "dry-run이므로 변경사항을 커밋하지 않습니다."
    return 0
  fi

  local message="release: prepare v${VERSION}"
  if (( ASSUME_YES == 0 )); then
    printf '\n커밋 메시지 [%s]: ' "$message"
    local entered=''
    IFS= read -r entered || true
    [[ -z $entered ]] || message=$entered
  fi

  git -C "$PROJECT_DIR" add -A
  GIT_AUTHOR_NAME="$EXPECTED_AUTHOR_NAME" \
  GIT_AUTHOR_EMAIL="$EXPECTED_AUTHOR_EMAIL" \
  GIT_COMMITTER_NAME="$EXPECTED_AUTHOR_NAME" \
  GIT_COMMITTER_EMAIL="$EXPECTED_AUTHOR_EMAIL" \
    git -C "$PROJECT_DIR" commit -m "$message"
}

validate_commits_to_publish() {
  local commits
  commits=$(git -C "$PROJECT_DIR" rev-list origin/main..HEAD)
  [[ -n $commits ]] || return 0

  log "새 커밋 메타데이터 검사"
  local policy_base_available=0
  if git -C "$PROJECT_DIR" cat-file -e "$COMMIT_POLICY_BASE^{commit}" 2>/dev/null &&
     git -C "$PROJECT_DIR" merge-base --is-ancestor "$COMMIT_POLICY_BASE" HEAD; then
    policy_base_available=1
  else
    warn "커밋 위생 정책 기준점을 찾지 못해 게시 대상 전체를 검사합니다."
  fi

  local commit author_name author_email committer_name committer_email body
  while IFS= read -r commit; do
    [[ -n $commit ]] || continue
    if (( policy_base_available == 1 )) &&
       ! git -C "$PROJECT_DIR" merge-base --is-ancestor "$COMMIT_POLICY_BASE" "$commit"; then
      continue
    fi

    author_name=$(git -C "$PROJECT_DIR" show -s --format='%an' "$commit")
    author_email=$(git -C "$PROJECT_DIR" show -s --format='%ae' "$commit")
    committer_name=$(git -C "$PROJECT_DIR" show -s --format='%cn' "$commit")
    committer_email=$(git -C "$PROJECT_DIR" show -s --format='%ce' "$commit")
    body=$(git -C "$PROJECT_DIR" show -s --format='%B' "$commit")

    [[ $author_name == "$EXPECTED_AUTHOR_NAME" && $author_email == "$EXPECTED_AUTHOR_EMAIL" ]] || \
      die "커밋 $commit Author가 예상 계정과 다릅니다: $author_name <$author_email>"
    [[ $committer_name == "$EXPECTED_AUTHOR_NAME" && $committer_email == "$EXPECTED_AUTHOR_EMAIL" ]] || \
      die "커밋 $commit Committer가 예상 계정과 다릅니다: $committer_name <$committer_email>"

    if printf '%s\n' "$body" | grep -Eqi '(codex|openai|chatgpt|claude|gemini|copilot)'; then
      die "커밋 $commit 메시지에서 AI 도구 흔적을 발견했습니다."
    fi
  done <<< "$commits"
}

ensure_release_not_already_published() {
  if gh release view "$TAG" --repo "$EXPECTED_REPO" >/dev/null 2>&1; then
    log "GitHub Release $TAG가 이미 존재합니다. 아무것도 변경하지 않고 종료합니다."
    exit 0
  fi
}

ensure_tag_safe() {
  if git -C "$PROJECT_DIR" rev-parse -q --verify "refs/tags/$TAG" >/dev/null; then
    local tagged_head
    tagged_head=$(git -C "$PROJECT_DIR" rev-list -n1 "$TAG")
    [[ $tagged_head == $(git -C "$PROJECT_DIR" rev-parse HEAD) ]] || \
      die "$TAG 태그가 다른 커밋을 가리키고 있습니다."
    log "$TAG 태그가 이미 현재 HEAD를 가리킵니다. 재사용합니다."
  fi

}

prepare_tag() {
  if ! git -C "$PROJECT_DIR" rev-parse -q --verify "refs/tags/$TAG" >/dev/null; then
    git -C "$PROJECT_DIR" tag -a "$TAG" -m "MILESTONE Core $TAG"
  fi
}

previous_version_tag() {
  git -C "$PROJECT_DIR" tag --merged HEAD --sort=-v:refname \
    | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' \
    | grep -Fxv "$TAG" \
    | head -n1 || true
}

make_release_notes() {
  local outfile=$1
  local previous
  previous=$(previous_version_tag)

  {
    printf '# MILESTONE Core %s\n\n' "$TAG"
    printf '%s\n\n' "$NOTES"
    printf '## Changes\n'
    if [[ -n $previous ]]; then
      git -C "$PROJECT_DIR" log --format='- %s' "$previous..HEAD"
    else
      git -C "$PROJECT_DIR" log -n 10 --format='- %s'
    fi
    printf '\n## Assets\n'
    printf -- '- `MILESTONE_Core.bin` — OTA firmware image\n'
    printf -- '- `MILESTONE_Core.json` — OTA manifest\n'
  } > "$outfile"
}

confirm_publish() {
  (( DRY_RUN == 0 )) || return 0
  (( ASSUME_YES == 1 )) && return 0

  printf '\n게시 대상:\n'
  printf '  Version: %s\n' "$VERSION"
  printf '  HEAD:    %s\n' "$(git -C "$PROJECT_DIR" log -1 --oneline)"
  printf '  Remote:  %s\n' "$(git -C "$PROJECT_DIR" remote get-url origin)"
  printf '\nGitHub에 main + %s 태그 + Release를 게시할까요? [y/N] ' "$TAG"
  local answer=''
  IFS= read -r answer || true
  [[ $answer == y || $answer == Y || $answer == yes || $answer == YES ]] || die "사용자가 게시를 취소했습니다."
}

publish_release() {
  local notes_file
  notes_file=$(mktemp /tmp/milestone-gh-release.XXXXXX.md)
  make_release_notes "$notes_file"

  prepare_tag
  confirm_publish

  log "main + $TAG 원자적 push"
  git -C "$PROJECT_DIR" push --atomic origin main "$TAG"
  REMOTE_PUSHED=1

  log "GitHub Release 게시"
  gh release create "$TAG" \
    "$PROJECT_DIR/release/MILESTONE_Core.bin" \
    "$PROJECT_DIR/release/MILESTONE_Core.json" \
    --repo "$EXPECTED_REPO" \
    --verify-tag \
    --title "MILESTONE Core $TAG" \
    --notes-file "$notes_file" \
    --latest

  rm -f -- "$notes_file"
}

prepare_local_mode() {
  PROJECT_DIR=$(pwd -P)
  validate_project_root "$PROJECT_DIR"
  validate_source_version "$PROJECT_DIR"
}


ensure_clean_worktree_or_normalize_modes() {
  local repo=$1

  if [[ -z $(git -C "$repo" status --porcelain) ]]; then
    return 0
  fi

  # Some external filesystems (for example exFAT) expose every extracted file
  # as executable. If the tracked contents are otherwise identical, ignore only
  # those mode-bit differences and persist that repository-local policy.
  if [[ -z $(git -C "$repo" -c core.fileMode=false status --porcelain) ]]; then
    git -C "$repo" config core.fileMode false
    return 0
  fi

  return 1
}

prepare_taildrop_mode() {
  if [[ -z $INPUT_ZIP ]]; then
    require_command tailscale
    require_command sudo
  fi

  PROJECT_DIR=$DEFAULT_PROJECT_DIR
  local invocation_dir dev_dir
  invocation_dir=$(pwd -P 2>/dev/null) || \
    die "현재 셸이 삭제되거나 교체된 디렉터리를 가리킵니다. 'cd /tmp' 후 다시 실행하세요."
  dev_dir=$(dirname "$PROJECT_DIR")
  [[ -d $dev_dir ]] || die "개발 디렉터리가 없습니다: $dev_dir"

  if [[ -d $PROJECT_DIR ]] && [[ $(realpath "$invocation_dir") == $(realpath "$PROJECT_DIR") ]]; then
    die "Taildrop 모드는 교체 대상 프로젝트 디렉터리 밖에서 실행해야 합니다. 'cd /tmp' 후 다시 실행하세요."
  fi

  if [[ -d $PROJECT_DIR ]]; then
    validate_project_root "$PROJECT_DIR"
    if [[ -n $(git -C "$PROJECT_DIR" status --porcelain) ]]; then
      git -C "$PROJECT_DIR" status --short >&2
      die "기존 프로젝트에 미커밋 변경이 있어 Taildrop으로 덮어쓰지 않습니다."
    fi
  fi

  TAILDROP_ROOT=$(mktemp -d "$dev_dir/.milestone-taildrop.XXXXXX")
  local inbox="$TAILDROP_ROOT/inbox"
  local unpack="$TAILDROP_ROOT/unpack"
  mkdir -p -- "$inbox" "$unpack"

  local zip
  if [[ -n $INPUT_ZIP ]]; then
    [[ -f $INPUT_ZIP ]] || die "지정한 ZIP 파일이 없습니다: $INPUT_ZIP"
    zip=$(realpath "$INPUT_ZIP")
    log "지정 ZIP 사용: $zip"
  else
    log "Tailscale Taildrop에서 파일 수신"
    sudo tailscale file get "$inbox"
    sudo chown -R -- "$USER:$(id -gn)" "$inbox"
    zip="$inbox/MILESTONE_Core_${VERSION}.zip"
    [[ -f $zip ]] || die "Taildrop에서 정확한 파일을 찾지 못했습니다: MILESTONE_Core_${VERSION}.zip"
  fi

  log "ZIP 구조 검증"
  local bad_entry=0 entry
  while IFS= read -r entry; do
    if [[ $entry == /* || $entry == *'/../'* || $entry == '../'* || $entry != MILESTONE_Core/* ]]; then
      printf '비정상 ZIP 경로: %s\n' "$entry" >&2
      bad_entry=1
    fi
  done < <(unzip -Z1 "$zip")
  (( bad_entry == 0 )) || die "ZIP 경로 구조가 안전하지 않습니다."

  unzip -q -- "$zip" -d "$unpack"
  local incoming="$unpack/MILESTONE_Core"
  validate_project_root "$incoming"
  validate_source_version "$incoming"

  if ! ensure_clean_worktree_or_normalize_modes "$incoming"; then
    git -C "$incoming" -c core.fileMode=false status --short >&2
    die "받은 프로젝트 Git 작업 트리가 clean 상태가 아닙니다."
  fi

  PROJECT_DIR=$incoming
}

swap_taildrop_project() {
  [[ $MODE == taildrop ]] || return 0
  (( DRY_RUN == 0 )) || {
    warn "dry-run이므로 기존 프로젝트를 교체하지 않습니다."
    return 0
  }

  local final_dir=$DEFAULT_PROJECT_DIR
  local dev_dir timestamp incoming
  dev_dir=$(dirname "$final_dir")
  timestamp=$(date '+%Y%m%d-%H%M%S')
  BACKUP_DIR="$dev_dir/.MILESTONE_Core.backup.$timestamp"
  incoming=$PROJECT_DIR

  log "검증된 Taildrop 프로젝트로 안전 교체"
  if [[ -d $final_dir ]]; then
    mv -- "$final_dir" "$BACKUP_DIR"
  else
    BACKUP_DIR=''
  fi
  mv -- "$incoming" "$final_dir"
  PROJECT_DIR=$final_dir
  SWAPPED_PROJECT=1
}

if [[ $MODE == local ]]; then
  prepare_local_mode
else
  prepare_taildrop_mode
fi

validate_git_identity
validate_branch_and_remote
refresh_remote
ensure_release_not_already_published

# Build before any local commit, project replacement, tag, or push.
build_release

if [[ $MODE == local ]]; then
  commit_local_changes_if_needed
else
  swap_taildrop_project
  # PROJECT_DIR changed from staging to final path after the swap.
  validate_git_identity
  validate_branch_and_remote
fi

validate_commits_to_publish
ensure_tag_safe

if (( DRY_RUN == 1 )); then
  log "dry-run 완료"
  echo "테스트와 릴리즈 빌드/검증까지 성공했습니다. Git/프로젝트/원격에는 변경을 가하지 않았습니다."
  exit 0
fi

publish_release

refresh_installed_command

if [[ -n $BACKUP_DIR && -d $BACKUP_DIR ]]; then
  rm -rf -- "$BACKUP_DIR"
  BACKUP_DIR=''
fi
SWAPPED_PROJECT=0

log "MILESTONE Core $TAG 릴리즈 완료"
gh release view "$TAG" --repo "$EXPECTED_REPO"
